// Solution-style root config: it holds no files of its own, only references.
//
// Editors resolve a file by walking up to the nearest tsconfig.json — this one. Because
// it lists references and no files, TypeScript searches the referenced projects instead
// of falling back to an inferred project, so `test/**` keeps full IntelliSense (strict,
// decorators) even though `npm run build` no longer looks at it.
//
//   tsconfig.app.json   src + build config  -> `npm run build` (tsc -b tsconfig.app.json)
//   tsconfig.test.json  the test tree       -> checked by `npm run typecheck` only
//
// `npm run typecheck` runs `tsc -b` against this file and so covers both.
{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.test.json"
    }
  ]
}
